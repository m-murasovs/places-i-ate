{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "npx prisma generate",
    "dev": "npm run generate && next dev --port 3737",
    "build": "npm run generate && next build",
    "start": "npm run generate && next start --port 3737",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.61.0",
    "@tanstack/react-query-devtools": "^5.61.4",
    "dotenv": "^16.4.5",
    "leaflet": "^1.9.4",
    "next": "14.2.15",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tanstack/eslint-plugin-query": "^5.61.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --max-warnings 0",
    "*.{js,jsx}": "eslint --fix --max-warnings 0"
  }
}
